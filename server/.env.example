# Server
DATABASE_URL=postgres://user:password@localhost:5432/channeled
# Set to "disable" to turn off SSL (e.g. local Postgres without certs).
PGSSL=disable
PORT=47822

# --- Auth (Google OAuth) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized JS origin:     http://localhost:47821
# Authorized redirect URIs: http://localhost:47822/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

# Local URL of the API.
BASE_URL=http://localhost:47822

# Where the OAuth callback redirects after a successful login.
CLIENT_URL=http://localhost:47821

# Comma-separated list of allowed CORS origins for credentialed requests.
# The Vite development origin.
CORS_ORIGINS=http://localhost:47821

# One-shot: the first time a user with this email signs in, all workspaces
# that have no owner are reassigned to them. Use to claim pre-auth data.
BACKFILL_USER_EMAIL=