# Server
DATABASE_URL=postgres://user:password@localhost:5432/channeled
# Set to "disable" to turn off SSL (e.g. local Postgres without certs).
PGSSL=disable
PORT=5174

# --- Auth (Google OAuth) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized JS origins:    http://localhost:5173  +  https://<your-domain>
# Authorized redirect URIs: http://localhost:5174/api/auth/google/callback
#                           https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

# Public base URL of the API. In dev this is the server port; in prod it's
# the same origin as the client (e.g. https://channeled.onrender.com).
BASE_URL=http://localhost:5174

# Where the OAuth callback redirects after a successful login. In dev this is
# the Vite client URL. In prod, omit to default to BASE_URL.
CLIENT_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins for credentialed requests.
# In prod (same origin), leave default; in dev you need the Vite origin.
CORS_ORIGINS=http://localhost:5173

# One-shot: the first time a user with this email signs in, all workspaces
# that have no owner are reassigned to them. Use to claim pre-auth data.
BACKFILL_USER_EMAIL=
